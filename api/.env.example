# Postgres (Supabase > Project settings > Database). Use the pooled URL for the app
# and the direct URL for migrations. If you have no pooler, use the same value twice.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# Supabase (Project settings > API). The service role key must stay on the server.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Long random string (e.g. `openssl rand -base64 48`). Used to hash magic-link tokens.
MAGIC_LINK_SECRET=""

# Email (Resend). Leave empty in development and set DEV_LOG_EMAILS=true instead.
RESEND_API_KEY=""
EMAIL_FROM="ClientOS <onboarding@resend.dev>"
DEV_LOG_EMAILS="true"

# Front end address: used for CORS and for links inside emails.
APP_URL="http://localhost:5173"
PORT=4000
LINK_TTL_DAYS=14
FILES_BUCKET="deliverables"
LOGOS_BUCKET="logos"
